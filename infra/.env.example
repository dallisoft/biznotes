# biznotes compose 환경 변수 예시 — `cp infra/.env.example infra/.env` 뒤 고친다.
# 적지 않은 값은 compose.yml의 기본값을 쓴다(개발용). 운영(APP_ENV=prod)은 아래 「비밀」을
# 반드시 바꿔야 기동한다.

# ===== 일반 =====
APP_ENV=dev
TAG=latest
# 컨테이너 시간대(로그)와 사용자에게 보이는 날짜 경계·시각
CONTAINER_TZ=Asia/Seoul
DISPLAY_TIMEZONE=Asia/Seoul
API_BASE_URL=http://localhost:28000
WEB_BASE_URL=http://localhost:23000
NEXT_PUBLIC_API_BASE_URL=http://localhost:28000
CORS_ORIGINS=http://localhost:23000
# api가 기동하며 마이그레이션을 적용한다. false면 `make migrate`로 따로
BIZNOTES_AUTO_MIGRATE=true

# ===== 비밀 =====
# 아래 세 값(POSTGRES_PASSWORD·JWT_SECRET·ENCRYPTION_KEY)은 저장소에 공개된 개발용 값이다.
# APP_ENV=prod에서 이 값 그대로면 api·worker가 기동을 거부한다. 예: openssl rand -hex 32
POSTGRES_USER=biznotes
POSTGRES_PASSWORD=biznotes
POSTGRES_DB=biznotes
JWT_SECRET=dev-jwt-secret
ENCRYPTION_KEY=dev-encryption-key-32-bytes-pad!

# ===== 파일 저장소 =====
# 기본은 data 볼륨(local). S3 호환 서버(RustFS·SeaweedFS 등)를 쓰려면 s3와 S3_* 값을 준다.
STORAGE_BACKEND=local
# S3_ENDPOINT=rustfs:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_SECURE=false

# ===== 검색·모델 =====
SEARCH_PROVIDER=searxng
# SearXNG 서명 키(이미지 프록시·리미터). 운영에서는 바꾼다. 예: openssl rand -hex 32
SEARXNG_SECRET=biznotes-dev-searxng-secret
# TAVILY_API_KEY=
# 로컬 LLM(ollama·LM Studio)이 도는 호스트 — 컨테이너에서 본 이름
LLM_LOCAL_HOST=host.docker.internal
# 폐쇄망이면 임베딩 모델을 model_cache 볼륨에 미리 받아 두고 1
HF_HUB_OFFLINE=0

# ===== 스킬 스크립트(선택) =====
# process로 켜려면 `docker compose --profile skill-scripts up -d worker-skill-sandbox`도 띄운다.
# 샌드박스는 서명 URL로만 파일을 주고받는다 — local이면 아래 기본값(api) 그대로 둔다.
# s3면 SKILL_SCRIPT_STORAGE_ENDPOINT=rustfs:9000, SKILL_SANDBOX_STORAGE_ORIGINS=http://rustfs:9000
# 처럼 둘 다 그 서버로 바꾸고, 그 서버를 skill_isolated 네트워크에도 붙인다.
SKILL_SCRIPT_BACKEND=disabled
# SKILL_SCRIPT_STORAGE_ENDPOINT=http://api:8000
# SKILL_SANDBOX_STORAGE_ORIGINS=http://api:8000
SKILL_STANDARD_RUNTIME_ENABLED=false

# ===== 한도(기본값 그대로면 적지 않아도 된다) =====
# RATE_LIMIT_ENABLED=true
# MAX_SOURCES_PER_NOTEBOOK=500
# AGENT_HTTP_EGRESS_MODE=fetch_only
